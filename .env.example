# Postgres connection string (required, at runtime — not needed to build).
#
# Local:  postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Vercel: use the *pooled* connection string from your provider, e.g.
#   Neon:           Dashboard → Connection Details → "Pooled connection"
#   Vercel Postgres / Neon integration: sets DATABASE_URL + POSTGRES_URL for you
#   Supabase:       Settings → Database → Connection pooling (port 6543)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# POSTGRES_URL is accepted as a fallback (Vercel/Neon integration default).
# POSTGRES_URL=
