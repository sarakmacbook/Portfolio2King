# Postgres connection string (required, at runtime — not needed to build).
#
# Local:  postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Vercel: use the *pooled* connection string from your provider, e.g.
#   Neon:           Dashboard → Connection Details → "Pooled connection"
#   Vercel Postgres / Neon integration: sets DATABASE_URL + POSTGRES_URL for you
#   Supabase:       Settings → Database → Connection pooling (port 6543)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# POSTGRES_URL is accepted as a fallback (Vercel/Neon integration default).
# POSTGRES_URL=

# Protect the web database setup endpoint. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set a random secret of at least 32 characters, then restart/redeploy.
# Never expose this as a NEXT_PUBLIC variable.
# DATABASE_SETUP_TOKEN=

# Local development can save .env.local from the web setup wizard.
# To explicitly enable file saving on a persistent, self-hosted production server:
# ALLOW_DATABASE_SETUP_WRITE=true
# File saving is always disabled on Vercel.

# Optional secret used by scheduled refresh endpoints
# (/api/cron/refresh-prices and /api/cron/daily-snapshot).
# Send it as: Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=

# --- Price refresh & alerts (all optional) ---------------------------------
# Telegram alerts: create a bot with @BotFather, message it once, then set the
# token and the chat id (use @userinfobot to find yours).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Web Push (browser / installed web clip). When unset, a VAPID key pair is
# generated once and stored in the database, so alerts work without extra setup.
# Set both values to use your own key pair instead.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact URL sent to push services (mailto: or https:).
# VAPID_SUBJECT=mailto:you@example.com
